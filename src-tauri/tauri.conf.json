{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面小助手",
  "version": "0.2.0",
  "identifier": "com.myassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "桌面小助手",
      "width": 880,
      "height": 620,
      "minWidth": 70,
      "minHeight": 70,
      "center": true,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "resizable": false,
      "skipTaskbar": false,
      "visible": true
    }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/capture-drafts/**"] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"] }
}
