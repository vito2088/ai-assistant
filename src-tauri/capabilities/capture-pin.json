{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-pin",
  "description": "Screenshot pins can be dragged, toggled on top, and saved",
  "windows": ["capture-pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "dialog:allow-save"
  ]
}
